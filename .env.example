# QueryForge local development environment variables
# Copy to .env and adjust values before starting the stack.

# ── Database ──────────────────────────────────────────────────────────────
QF_DB_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_DB_PASSWORD
QF_DB_PORT=
# POSTGRES_USER / POSTGRES_DB are fixed in docker-compose.yml (queryforge)

# ── Application ───────────────────────────────────────────────────────────
QF_SPRING_PROFILE=default
# Use "local-auth" for the authenticated stack (OIDC + CSRF).
QF_API_PORT=8081
QF_WEB_PORT=8080
QF_WEB_BASE_URL=http://localhost:8080
SERVER_ADDRESS=0.0.0.0
QF_RUNNER_BASE_URL=http://127.0.0.1:8080

# ── Keycloak (authenticated profile only) ─────────────────────────────────
QF_KEYCLOAK_ADMIN=qf-admin
QF_KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_KEYCLOAK_PASSWORD
QF_OIDC_CLIENT_SECRET_FILE=./secrets/qf_oidc_client_secret.txt.example

# ── Monitoring ports ──────────────────────────────────────────────────────
QF_MAILPIT_PORT=8025
QF_PROMETHEUS_PORT=9090
QF_ALERTMANAGER_PORT=9093

# ── Production-only required variables ────────────────────────────────────
# QF_OIDC_CLIENT_ID=
# QF_OIDC_ISSUER_URI=
# QF_OIDC_GROUP_CLAIM=groups
# QF_OIDC_OPERATOR_GROUPS=
# QF_OIDC_CLIENT_SECRET_FILE=
# QF_POSTGRES_ADMIN_PASSWORD_FILE=
# QF_APP_DB_PASSWORD_FILE=
# QF_MONITOR_DB_PASSWORD_FILE=
# QF_SMTP_HOST=
# QF_SMTP_FROM=
# QF_SMTP_USERNAME=
# QF_SMTP_PASSWORD_FILE=
# QF_ALERT_EMAIL=
# QF_DOMAIN=
# QF_ACME_EMAIL=
# QF_RATE_LIMIT_REQUESTS_PER_MINUTE=600
# QF_RATE_LIMIT_ENABLED=true
# QF_BACKUP_INTERVAL_SECONDS=86400
# QF_BACKUP_RETENTION_DAYS=14
