FROM quay.io/prometheus/alertmanager:v0.28.1 AS alertmanager

FROM alpine:3.22
RUN apk add --no-cache ca-certificates gettext \
    && mkdir -p /alertmanager \
    && chown 65534:65534 /alertmanager
COPY --from=alertmanager /bin/alertmanager /bin/alertmanager
COPY monitoring/alertmanager.yml.tmpl /etc/alertmanager/alertmanager.yml.tmpl
COPY scripts/start-alertmanager.sh /usr/local/bin/start-alertmanager
RUN chmod 0555 /usr/local/bin/start-alertmanager \
    && chmod 0444 /etc/alertmanager/alertmanager.yml.tmpl
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/start-alertmanager"]
