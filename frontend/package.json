{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "cross-env ESBUILD_MAX_WORKERS=1 NODE_OPTIONS=--max-old-space-size=8192 ng build",
    "build:analyze": "cross-env ESBUILD_MAX_WORKERS=1 NODE_OPTIONS=--max-old-space-size=8192 ng build --stats-json",
    "watch": "cross-env ESBUILD_MAX_WORKERS=1 NODE_OPTIONS=--max-old-space-size=8192 ng build --watch --configuration development",
    "test": "cross-env ESBUILD_MAX_WORKERS=1 NODE_OPTIONS=--max-old-space-size=8192 ng test --watch=false",
    "test:watch": "cross-env ESBUILD_MAX_WORKERS=1 NODE_OPTIONS=--max-old-space-size=8192 ng test",
    "e2e": "playwright test",
    "e2e:ci": "playwright test e2e/first-session.spec.ts",
    "e2e:real": "playwright test e2e/real-stack.spec.ts",
    "e2e:screenshots": "playwright test e2e/screenshots.spec.ts"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "chart.js": "^4.4.7",
    "ng2-charts": "^11.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.9.1",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.9.1",
    "cross-env": "^10.1.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.1",
    "typescript": "~7.0.2"
  }
}
